# to initialize dotfiles on new machine run these commands:
# git clone --bare https://github.com/sporkl/dotfiles.git $HOME/.dotfiles
# alias gdm='/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
# gdm checkout
# to add/update a subtree: gdm <add/update> -P <local path> <remote url or ref> <remote branch if not ref> --squash

export PATH="$HOME/.config/vrs:$PATH" # add vrs vim wrapper to path
export EDITOR='vrs'

export HISTSIZE=20000

# z command for fast traversal
. ~/.config/z/z.sh

alias gdm='git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
# to update: gdm pull

imgcompress () { magick "$1" -strip -interlace Plane -gaussian-blur 0.05 -quality 85% "$1".jpg }
pdfcompress () {
	for f in "$@"; do
	echo "compressing $f"
		pdf2ps "$f" "$f".ps
		ps2pdf -dPDFSETTINGS=/default "$f".ps "$f"
		rm "$f".ps
	done
}

alias movs2mp4s='for i in *.mov; do ffmpeg -i "$i" "${i%.*}.mp4"; done'
alias all2flac='for i in *; do ffmpeg -i "$i" "${i%.*}.flac"; done'
alias findlarge='du -ah | sort -rh | head'
